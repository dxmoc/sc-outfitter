<Window x:Class="ScOutfitter.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="sc-outfitter" Width="560" Height="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True"
        MouseLeftButtonDown="OnDrag">
    <Border CornerRadius="14" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1E232B" Offset="0" />
                <GradientStop Color="#FF12151A" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>
        <Grid Margin="40,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource Accent}" VerticalAlignment="Center">
                    <Path Data="M6,30 L22,6 L38,30 L22,24 Z" Fill="{StaticResource Bg}" Stretch="Uniform" Margin="10" />
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="sc-outfitter" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
                    <TextBlock Text="best loadout + shopping route for Star Citizen" Style="{StaticResource MutedText}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="1" Margin="0,28,0,0" Style="{StaticResource MutedText}" Text="Stanton · Pyro · Nyx" />

            <StackPanel Grid.Row="3" x:Name="LoadingPanel" VerticalAlignment="Bottom">
                <TextBlock x:Name="StatusText" Text="Starting ..." Margin="0,0,0,10" />
                <ProgressBar x:Name="Progress" IsIndeterminate="True" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" FontSize="11"
                           Text="First start downloads the component catalogue (about a minute). After that it is cached for a day." />
            </StackPanel>

            <StackPanel Grid.Row="3" x:Name="ChoicePanel" Visibility="Collapsed" VerticalAlignment="Bottom">
                <TextBlock Text="Ready. What do you want to do?" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Plan a loadout" Style="{StaticResource AccentButton}" Margin="0,0,6,0" Click="OnPlanner"
                            AutomationProperties.Name="Plan a loadout" />
                    <Button Grid.Column="1" Content="Route for an erkul build" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnErkul"
                            AutomationProperties.Name="Route for an erkul build" />
                </Grid>
                <TextBox x:Name="ErkulLinkBox" Margin="0,10,0,0" ToolTip="erkul.games share link, browse link or id" />
                <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"
                           Text="For the erkul route: paste the build link here first (or later in the app)." />
            </StackPanel>

            <StackPanel Grid.Row="3" x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Bottom">
                <TextBlock Text="Could not load the data" Foreground="{StaticResource Warn}" FontWeight="SemiBold" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,12" MaxHeight="70" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Retry" Style="{StaticResource AccentButton}" Padding="18,7" Click="OnRetry" />
                    <Button Content="Quit" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnQuit" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="4" x:Name="VersionText" Style="{StaticResource MutedText}" FontSize="11" Margin="0,18,0,0" HorizontalAlignment="Right" />
        </Grid>
    </Border>
</Window>
